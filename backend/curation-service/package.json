{
  "name": "curation-service",
  "version": "1.0.0",
  "main": "./dist/app.js",
  "scripts": {
    "build": "npx prisma generate && npx tsc",
    "start": "npx prisma db push --accept-data-loss && node dist/src/app.js",
    "dev": "nodemon",
    "docker:build": "docker build -t curation-service .",
    "docker:run": "docker run -p 8002:8002 curation-service",
    "prisma:deploy": "prisma migrate deploy",
    "healthcheck": "node dist/src/healthcheck.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Curation bounded context — user-owned Collections (the Vault) of curated videos.",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@clerk/express": "^1.3.31",
    "@prisma/client": "^6.1.0",
    "@types/amqplib": "^0.10.8",
    "amqplib": "^2.0.1",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "nodemon": "^3.1.9",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
